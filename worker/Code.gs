ык». Не записывай телефоны, адреса, имена, деньги, разовые вопросы и то, что уже есть в памяти. Чаще всего []\"], \"forget\": [\"пункты памяти, которые гость в последнем сообщении отменил или опроверг, дословно как в памяти; обычно []\"], \"dishes\": [\"0–3 блюда, которые ты советуешь: всегда ТОЧНОЕ РУССКОЕ название из меню, как оно написано до скобок, даже если ответ на другом языке\"]}";
const TONES = { warm: "тёплый и весёлый, как описано в ХАРАКТЕРЕ", short: "коротко и по делу, шутки реже", fun: "максимально весело, с шутками и поговорками" };
const ADMIN = "РЕЖИМ АДМИНИСТРАТОРА: сейчас пишет сотрудник ресторана, вошедший в админку. Здесь ты не продаёшь блюда, а помогаешь работать с сайтом: коротко, по делу, по шагам, без шуток про еду. САМ ты ничего не меняешь — только объясняешь и даёшь кнопку перехода (поле \"go\").\nКак устроена админка (это демо: изменения сохраняются в браузере этого устройства):\n- Если блюдо закончилось — галочку «Нет в наличии» нужно ПОСТАВИТЬ; когда снова есть — СНЯТЬ. Обращайся к сотруднику нейтрально, без «азиз мехмон».\n- Цена, стоп-лист, раздел, удаление блюда: страница «Меню» → у карточки кнопка «Изменить» → поле цены, галочка «Нет в наличии», выбор раздела, «Удалить» (два нажатия) → «Сохранить».\n- Новое блюдо: страница «Меню» → в нужном разделе кнопка «+ Добавить блюдо» → название, цена, выход, раздел, состав, фото → «Добавить».\n- Заявки на бронь: «Панель» (admin.html) → вкладка «Брони»: подтвердить или удалить заявку.\n- Сводная таблица меню и сброс к исходному: «Панель» → «Меню и стоп-лист».\n- Помощник: «Панель» → «AI-помощник»: приветствие, тон, адрес AI-сервера с проверкой связи.\n- Тема (солнце/луна в шапке), языки RU/UZ/EN в шапке, выход из админки — кнопка «Выйти» в верхней жёлтой полосе. Вход — «Вход для персонала» внизу сайта.\n- Чего пока нет: общих для всех изменений (нужен сервер), фото к блюдам из Telegram, онлайн-оплаты.\nПоле \"go\" ОБЯЗАТЕЛЬНО, когда речь о конкретном блюде (цена, стоп-лист, «закончился», удалить, перенести) — тогда {\"to\":\"edit\"}; о новом блюде — {\"to\":\"add\"}; о бронях/настройках — {\"to\":\"tab\"}. Иначе null. Варианты: {\"to\":\"edit\",\"dish\":\"точное русское название из меню\"} — открыть карточку блюда в режиме правки; {\"to\":\"add\",\"cat\":\"id раздела: shashlik|milliy|uygur|salat|yevropa|non|ichimlik\"} — открыть добавление в раздел; {\"to\":\"tab\",\"tab\":\"bookings|menu|ai|overview\"} — открыть вкладку панели. Если просят изменить блюдо, которого нет в меню, — так и скажи и предложи добавить новое (\"to\":\"add\").\n";
// Google keeps the admin's promotions itself, so here they never come from the visitor
const NOTES_OF = () => { const n = PropertiesService.getScriptProperties().getProperty("NOTES") || ""; return n.trim() ? n.slice(0, 1500).replace(/[\r\n]+/g, " | ") : "сейчас нет"; };

function doGet() { return out_({ ok: true, hint: "POST only" }); }

function doPost(e) {
  try { return out_(handle_(JSON.parse(e.postData.contents || "{}"))); }
  catch (err) { return out_({ error: "bad request", detail: String(err).slice(0, 200) }); }
}

function out_(obj) { return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON); }

function post_(url, headers, body) {
  const r = UrlFetchApp.fetch(url, { method: "post", contentType: "application/json", headers: headers, payload: JSON.stringify(body), muteHttpExceptions: true });
  return { status: r.getResponseCode(), text: r.getContentText(), retry: +(r.getHeaders()["Retry-After"] || r.getHeaders()["retry-after"] || 0) };
}

function handle_(body) {
  const P = PropertiesService.getScriptProperties();
  const AI_KEY = P.getProperty("AI_KEY"), GROQ_KEY = P.getProperty("GROQ_KEY"), MODEL = P.getProperty("MODEL"), GROQ_MODEL = P.getProperty("GROQ_MODEL");

  // ---- promotions / news written by the admin, shared by everyone ----
  if (body.action === "notes_get") return { notes: P.getProperty("NOTES") || "", updated: P.getProperty("NOTES_AT") || "" };
  if (body.action === "notes_set") {
    const c = CacheService.getScriptCache(); const tries = +(c.get("bad_pw") || 0);
    if (tries >= 5) return { error: "too many attempts, wait 10 minutes" };
    const pass = P.getProperty("ADMIN_PASS") || "129091";
    if (String(body.password || "") !== pass) { c.put("bad_pw", String(tries + 1), 600); return { error: "wrong password" }; }
    const notes = String(body.notes || "").slice(0, 1500);
    P.setProperty("NOTES", notes); P.setProperty("NOTES_AT", new Date().toISOString());
    return { ok: true, notes: notes };
  }

  if (!AI_KEY && !GROQ_KEY) return { error: "AI_KEY is not set" };

  // simple global limit: 60 requests per minute for the whole site
  const cache = CacheService.getScriptCache(); const slot = "m" + Math.floor(Date.now() / 60000);
  const used = +(cache.get(slot) || 0); if (used > 60) return { error: "busy", retryAfter: 30 }; cache.put(slot, String(used + 1), 120);

  const msgs = (Array.isArray(body.messages) ? body.messages : []).slice(-10)
    .filter(m => m && typeof m.text === "string" && m.text.trim())
    .map(m => ({ role: m.role === "bot" ? "model" : "user", parts: [{ text: m.text.slice(0, 600) }] }));
  if (!msgs.length || msgs[msgs.length - 1].role !== "user") return { error: "no question" };

    const last = msgs[msgs.length - 1].parts[0].text;
    // reply in the site's language unless the guest clearly wrote in another one
    const site = ["ru", "uz", "en"].includes(body.lang) ? body.lang : "ru";
    const words = last.toLowerCase();
    const isUz = /[ўқғҳ]|o['ʻ‘’`]|g['ʻ‘’`]|\b(va|bor|bormi|qanday|qanaqa|nima|nimalar|kerak|qancha|necha|salom|assalomu|rahmat|menga|uchun|bilan|qayer|qayerda|vaqt|ish|soat|bugun|ertaga|stol|bron|yetkazib|ovqat|taom|osh|yoq|yo'q|ha|xop|mumkinmi|bera|olsa|kishi|kishilik)\b|(lar|ingiz|imiz|dan|ga|da|ni)\b/.test(words);
    const isEn = /\b(the|you|your|what|where|when|how|do|does|is|are|have|has|can|i|we|my|menu|price|open|book|table|recommend|food|dish|hello|hi|thanks|please)\b/.test(words);
    const isRu = /[а-яё]/.test(words) && !/[ўқғҳ]/.test(words);
    const lang = isRu ? "ru" : isUz && !isEn ? "uz" : isEn && !isUz ? "en" : site;
    const LANGS = { ru: "русский (названия блюд — как в меню до скобок, цены в сумах: «48 000 сум»)",
                    uz: "o'zbek tili, lotin yozuvida (taom nomlari — qavs ichidagi o'zbekcha nomlar, narxlar: «48 000 so'm»; kirill harflarini ishlatma)",
                    en: "English (translate dish names to English, prices like «48,000 UZS»; no Cyrillic)" };
    const mem = (Array.isArray(body.memory) ? body.memory : []).filter(x => typeof x === "string").slice(0, 12).map(x => x.slice(0, 80).replace(/[\n\r]/g, " "));
    let SYS = SYSTEM.replace("{TONE}", TONES[body.tone] || TONES.warm).replace("{LANG}", LANGS[lang]).replace("{MEMORY}", mem.length ? mem.join("; ") : "пока ничего").replace("{NOTES}", NOTES_OF(body));
    if (body.admin) SYS += "\n\n" + ADMIN + "\nДобавь в JSON-ответ поле \"go\".";
    // repeat the language right next to the question: weaker models follow this more reliably
    const NOTE = { ru: "[Ответь только по-русски, кириллицей.]", uz: "[Faqat o'zbek tilida, faqat LOTIN harflarida javob ber. Kirill harflari va ruscha so'z/iboralar taqiqlangan. Taom nomlarini menyudagi qavs ichidagi o'zbekcha nomdan ol (masalan: Beshbarmoq, 2 qism).]", en: "[Reply in English only.]" }[lang];
    msgs[msgs.length - 1] = { role: "user", parts: [{ text: last + "\n\n" + NOTE }] };
    let raw = "", err = "", provider = "", retryAfter = 0, limited = false;
    if (AI_KEY) {
      const tries = [];
      [MODEL, "gemini-3.5-flash-lite", "gemini-flash-latest"].filter(Boolean).forEach(model =>
        [{ thinkingLevel: "minimal" }, { thinkingBudget: 0 }, null].forEach(think => tries.push({ model: model, think: think })));
      const okRaw = cache.get("gem_ok"); const ok = okRaw ? JSON.parse(okRaw) : null;
      const order = ok ? [ok].concat(tries) : tries;
      let r;
      for (const t of order) {
        const payload = { systemInstruction: { parts: [{ text: SYS }] }, contents: msgs, generationConfig: { temperature: 0.7, maxOutputTokens: 900, responseMimeType: "application/json" } };
        if (t.think) payload.generationConfig.thinkingConfig = t.think;
        r = post_("https://generativelanguage.googleapis.com/v1beta/models/" + t.model + ":generateContent", { "x-goog-api-key": AI_KEY }, payload);
        if (r.status === 200) { cache.put("gem_ok", JSON.stringify(t), 21600); break; }
        if ([400, 404].indexOf(r.status) < 0) break;
      }
      if (r.status === 200) { const d = JSON.parse(r.text); raw = ((d.candidates || [])[0]?.content?.parts || []).map(p => p.text || "").join(""); if (raw) provider = "gemini"; }
      else { err = "gemini " + r.status + ": " + r.text.slice(0, 200); if (r.status === 429) { limited = true; retryAfter = r.retry; } }
    }
    if (!raw && GROQ_KEY) {
      const chat = [{ role: "system", content: SYS }].concat(msgs.map(m => ({ role: m.role === "model" ? "assistant" : "user", content: m.parts[0].text })));
      for (const model of [GROQ_MODEL, "openai/gpt-oss-120b", "qwen/qwen3.8-27b", "openai/gpt-oss-20b"].filter(Boolean)) {
        const extra = model.indexOf("openai/") === 0 ? { reasoning_effort: "low" } : model.indexOf("qwen/") === 0 ? { reasoning_format: "hidden" } : {};
        const g = post_("https://api.groq.com/openai/v1/chat/completions", { Authorization: "Bearer " + GROQ_KEY },
          Object.assign({ model: model, messages: chat, temperature: 0.7, max_tokens: 900, response_format: { type: "json_object" } }, extra));
        if (g.status === 200) { const d = JSON.parse(g.text); raw = (d.choices || [])[0]?.message?.content || ""; if (raw) { provider = "groq"; break; } continue; }
        if (g.status === 429) { limited = true; retryAfter = Math.max(retryAfter, Math.ceil(g.retry || 0)); }
        err += " | groq " + g.status + ": " + g.text.slice(0, 160);
        if ([400, 404, 429].indexOf(g.status) < 0) break;
      }
    }
    if (!raw && limited) return { error: "busy", retryAfter: Math.min(60, Math.max(5, retryAfter || 20)) };
    if (!raw) return { error: "ai unavailable", detail: err.slice(0, 400) };
    let o; try { o = JSON.parse(raw); } catch (x) { o = { reply: raw.replace(/[{}"]/g, "").trim(), dishes: [] }; }
    const clean = a => (Array.isArray(a) ? a : []).filter(x => typeof x === "string" && x.trim()).slice(0, 3).map(x => x.trim().slice(0, 80));
    const go = body.admin && o.go && typeof o.go === "object" && ["edit", "add", "tab"].indexOf(o.go.to) >= 0 ? { to: o.go.to, dish: String(o.go.dish || "").slice(0, 80), cat: String(o.go.cat || "").slice(0, 20), tab: String(o.go.tab || "").slice(0, 20) } : null;
    return { reply: String(o.reply || "").slice(0, 900), go: go, dishes: Array.isArray(o.dishes) ? o.dishes.slice(0, 4) : [], remember: clean(o.remember), forget: clean(o.forget), provider: provider, switched: provider === "groq" && !!AI_KEY };

}
